{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ],
  "env": {
    "REACT_APP_BACKEND_ENV": "production",
    "REACT_APP_PRODUCTION_BACKEND_URL": "http://52.14.251.189:5000",
    "REACT_APP_DEVELOPMENT_BACKEND_URL": "https://horse-shipt.vercel.app"
  }
}
